datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String        @id @default(cuid())
  name             String
  email            String        @unique
  emailVerified    Boolean       @default(false)
  image            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  sessions         Session[]
  accounts         Account[]
  favoriteGifs     FavoriteGif[]
  authyPermissions String?       @db.Text
}

model FavoriteGif {
  id         String   @id @default(cuid())
  userId     String
  providerId String
  slug       String
  title      String
  previewUrl String   @db.Text
  url        String   @db.Text
  width      Int?
  height     Int?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, providerId])
  @@index([userId, createdAt])
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Workspace {
  id          String                @id @default(cuid())
  name        String
  image       String?
  accentColor String                @default("#4a154b")
  ownerId     String
  channels    Channel[]
  memberships Membership[]
  invitations Invitation[]
  roles       WorkspaceRole[]
  inviteLinks WorkspaceInviteLink[]
  domainRules WorkspaceDomainRule[]
}

model Channel {
  id          String    @id @default(cuid())
  name        String
  description String?
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
}

model Membership {
  id            String         @id @default(cuid())
  userId        String
  email         String
  workspaceId   String
  workspace     Workspace      @relation(fields: [workspaceId], references: [id])
  role          String?        @default("member")
  roleId        String?
  joinedAt      DateTime?      @default(now())
  workspaceRole WorkspaceRole? @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@unique([userId, workspaceId])
  @@index([roleId])
}

model WorkspaceRole {
  id          String                @id @default(cuid())
  workspaceId String
  name        String
  color       String                @default("#a1a1aa")
  permissions String                @db.Text
  position    Int                   @default(0)
  isDefault   Boolean               @default(false)
  isManaged   Boolean               @default(false)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  workspace   Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  memberships Membership[]
  inviteLinks WorkspaceInviteLink[]
  domainRules WorkspaceDomainRule[]

  @@unique([workspaceId, name])
  @@index([workspaceId, position])
}

model WorkspaceInviteLink {
  id          String         @id @default(cuid())
  token       String         @unique
  workspaceId String
  createdById String
  roleId      String?
  maxUses     Int?
  useCount    Int            @default(0)
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime       @default(now())
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  role        WorkspaceRole? @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([roleId])
}

model WorkspaceDomainRule {
  id          String         @id @default(cuid())
  workspaceId String
  domain      String
  roleId      String?
  createdAt   DateTime       @default(now())
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  role        WorkspaceRole? @relation(fields: [roleId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, domain])
  @@index([domain])
  @@index([roleId])
}

model Invitation {
  id           Int       @id @default(autoincrement())
  email        String
  token        String    @unique
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id])
  invitedById  String
  acceptedById String?
  createdAt    DateTime  @default(now())
  acceptedAt   DateTime?
}
