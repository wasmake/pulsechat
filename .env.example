MYSQL_DATABASE=pulsechat
MYSQL_USER=pulsechat
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-password
PULSECHAT_PORT=3000

# Public PulseChat origin. Use HTTPS in production and omit a trailing slash.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Authy OIDC provider. AUTHY_ISSUER is Authy's public BETTER_AUTH_URL.
AUTHY_ISSUER=http://localhost:3001
AUTHY_CLIENT_ID=pulsechat
AUTHY_CLIENT_SECRET=replace-with-at-least-32-random-characters

# Stream Chat and Video credentials from https://getstream.io
NEXT_PUBLIC_STREAM_API_KEY=
STREAM_API_SECRET=

# Optional: enables the searchable KLIPY GIF picker.
KLIPY_API_KEY=
