    "is-hotkey": "^0.2.0",
    "lodash": "^4.17.21",
    "nanoid": "^5.0.8",
    "next": "14.2.14",
    "react": "^18",
    "react-dom": "^18",
    "slate": "^0.110.2",
    "slate-history": "^0.109.0",
